# Clé API Google Gemini (gratuite sur Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini à utiliser
GEMINI_MODEL=gemini-3.8-flash

# 'gemini' pour la vraie extraction, 'mock' pour des données factices sans appel API (dev gratuit)
EXTRACTION_PROVIDER=gemini

# Configuration du serveur FastAPI
HOST=0.0.0.0
PORT=8000
