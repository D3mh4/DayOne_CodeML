# ==============================================================================
# CONFIGURATION DES FOURNISSEURS IA (Google Gemini & Groq)
# ==============================================================================

# 1. GOOGLE GEMINI (Recommandé pour le hackathon Défi CodeML - Meilleur OCR manuscrit)
# Obtenez une clé GRATUITE en 1 minute sur: https://aistudio.google.com/apikey (avec compte Gmail perso)
# La clé doit commencer par AIzaSy...
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-flash-latest

# 2. GROQ VISION (Alternative ultra-rapide)
# Obtenez une clé GRATUITE sur: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.2-11b-vision-preview

# 3. STRATÉGIE D'EXTRACTION:
# - 'auto'   : Gemini en priorité, puis Groq si configuré. Si tout échoue : erreur claire, la photo reste
#              en file sur le téléphone et sera renvoyée (jamais de données inventées)
# - 'gemini' : Utilise uniquement Google Gemini
# - 'groq'   : Utilise uniquement Groq Vision
# - 'mock'   : Données de test simulées sans appel réseau (marquées « SIMULÉES » dans l'app)
# Sans aucune clé configurée, le serveur passe aussi en mode simulation (marqué comme tel).
EXTRACTION_PROVIDER=auto

# Configuration du serveur FastAPI
HOST=0.0.0.0
PORT=8000
